# Backend application configuration
# Copy to .env and set values. Fallbacks exist for backward compatibility.

# Database (required for production)
DATABASE_URL=postgresql://user:pass@host:port/dbname?sslmode=require

# AWS S3 (for paper storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=paper-full-texts

# ConvertAPI (PDF to HTML/DOCX)
CONVERTAPI_CREDENTIALS=

# Semantic Scholar API
SEMANTICSCHOLAR_API_KEY=

# Environment (production disables CORS allow_origins *)
ENV=development
